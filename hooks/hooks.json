{
  "description": "Notchu: show Claude Code sessions in the notch and approve or deny permission requests there. Needs the Notchu app running with Live approvals on, and NOTCHU_HOOK_TOKEN set.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47615/hooks/claude-code",
            "timeout": 10,
            "headers": {
              "Authorization": "Bearer ${NOTCHU_HOOK_TOKEN}",
              "X-Notchu-Term-Program": "${TERM_PROGRAM}",
              "X-Notchu-Term-Session-Id": "${TERM_SESSION_ID}",
              "X-Notchu-Iterm-Session-Id": "${ITERM_SESSION_ID}",
              "X-Notchu-Tmux": "${TMUX}",
              "X-Notchu-Tmux-Pane": "${TMUX_PANE}"
            },
            "allowedEnvVars": ["NOTCHU_HOOK_TOKEN", "TERM_PROGRAM", "TERM_SESSION_ID", "ITERM_SESSION_ID", "TMUX", "TMUX_PANE"]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47615/hooks/claude-code",
